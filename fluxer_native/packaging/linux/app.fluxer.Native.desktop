[Desktop Entry]
Name=Fluxer Native
GenericName=Instant Messenger
Comment=Native Fluxer text, voice and screen sharing
Exec=fluxer-desktop %u
Icon=app.fluxer.Native
Terminal=false
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/fluxer;
StartupWMClass=app.fluxer.Native
